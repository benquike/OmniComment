{
  "name": "markco",
  "displayName": "OmniComment - Universal Comments & Annotations",
  "description": "Universal commenting and inline annotation system for editors, web, and AI agents",
  "version": "0.1.15",
  "publisher": "OrenMaoz",
  "repository": {
    "type": "git",
    "url": "https://github.com/babonet/Markco.git"
  },
  "bugs": {
    "url": "https://github.com/babonet/Markco/issues"
  },
  "homepage": "https://github.com/babonet/Markco#readme",
  "icon": "media/markco.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:markdown",
    "onLanguage:skill",
    "onCustomEditor:zaaack.markdown-editor",
    "onCustomEditor:cweijan.markdownViewer",
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "markco.addComment",
        "title": "Add Comment",
        "category": "OmniComment",
        "icon": "$(comment)"
      },
      {
        "command": "markco.deleteComment",
        "title": "Delete Comment",
        "category": "OmniComment"
      },
      {
        "command": "markco.editComment",
        "title": "Edit Comment",
        "category": "OmniComment"
      },
      {
        "command": "markco.toggleSidebar",
        "title": "Toggle Comment Sidebar",
        "category": "OmniComment"
      },
      {
        "command": "markco.navigateToComment",
        "title": "Navigate to Comment",
        "category": "OmniComment"
      },
      {
        "command": "markco.editorCommentAction",
        "title": "In-Editor Comment Action",
        "category": "OmniComment"
      },
      {
        "command": "markco.inlineReplyComment",
        "title": "Respond",
        "category": "OmniComment"
      },
      {
        "command": "markco.inlineToggleResolve",
        "title": "Resolve / Reopen Comment",
        "category": "OmniComment",
        "icon": "$(check)"
      },
      {
        "command": "markco.inlineDeleteThread",
        "title": "Delete Comment Thread",
        "category": "OmniComment",
        "icon": "$(trash)"
      },
      {
        "command": "markco.inlineDeleteCommentItem",
        "title": "Delete Comment / Response",
        "category": "OmniComment",
        "icon": "$(trash)"
      },
      {
        "command": "markco.toggleCollapseAllComments",
        "title": "Collapse / Expand All In-Editor Comments",
        "category": "OmniComment",
        "icon": "$(collapse-all)"
      },
      {
        "command": "omnicomment.applyPreset",
        "title": "Apply Preset Configuration...",
        "category": "OmniComment",
        "icon": "$(gear)"
      },
      {
        "command": "omnicomment.agent.getComments",
        "title": "Agent: Get Comments",
        "category": "OmniComment"
      },
      {
        "command": "omnicomment.agent.postComment",
        "title": "Agent: Post Comment",
        "category": "OmniComment"
      },
      {
        "command": "omnicomment.agent.replyComment",
        "title": "Agent: Reply Comment",
        "category": "OmniComment"
      },
      {
        "command": "omnicomment.agent.resolveComment",
        "title": "Agent: Resolve Comment",
        "category": "OmniComment"
      },
      {
        "command": "omnicomment.agent.deleteComment",
        "title": "Agent: Delete Comment",
        "category": "OmniComment"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "when": "(editorLangId == markdown || editorLangId == skill) && editorHasSelection",
          "command": "markco.addComment",
          "group": "markco"
        }
      ],
      "editor/title": [
        {
          "when": "editorLangId == markdown || editorLangId == skill || resourceExtname == .md || resourceExtname == .markdown || resourceExtname == .skill || activeCustomEditorId == cweijan.markdownViewer || activeCustomEditorId == zaaack.markdown-editor",
          "command": "markco.addComment",
          "group": "navigation"
        },
        {
          "when": "editorLangId == markdown || editorLangId == skill",
          "command": "markco.toggleCollapseAllComments",
          "group": "navigation"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "markco.inlineReplyComment",
          "when": "commentController == markco-inline",
          "group": "inline"
        }
      ],
      "comments/commentThread/title": [
        {
          "command": "markco.inlineToggleResolve",
          "when": "commentController == markco-inline",
          "group": "navigation@1"
        },
        {
          "command": "markco.inlineDeleteThread",
          "when": "commentController == markco-inline",
          "group": "navigation@2"
        }
      ],
      "comments/comment/title": [
        {
          "command": "markco.inlineDeleteCommentItem",
          "when": "commentController == markco-inline",
          "group": "inline"
        }
      ]
    },
    "keybindings": [
      {
        "command": "markco.addComment",
        "key": "ctrl+shift+m",
        "mac": "cmd+shift+m",
        "when": "editorLangId == markdown || editorLangId == skill || resourceExtname == .md || resourceExtname == .markdown || resourceExtname == .skill || activeCustomEditorId == cweijan.markdownViewer || activeCustomEditorId == zaaack.markdown-editor"
      }
    ],
    "configuration": {
      "title": "OmniComment",
      "properties": {
        "omnicomment.preset": {
          "type": "string",
          "enum": [
            "default",
            "documentation-site",
            "git-file-review",
            "browser-annotator",
            "team-collaboration",
            "ai-agent-reviewer"
          ],
          "default": "default",
          "description": "Pre-configured profile tailoring UI density, storage mode, and agent review capabilities"
        },
        "markco.highlightColor": {
          "type": "string",
          "default": "rgba(255, 212, 0, 0.3)",
          "description": "Background color for comment highlights"
        },
        "markco.highlightBorderColor": {
          "type": "string",
          "default": "rgba(255, 212, 0, 0.8)",
          "description": "Border color for comment highlights"
        }
      }
    },
    "markdown.markdownItPlugins": true,
    "markdown.previewStyles": [
      "./media/preview.css"
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "pretest": "npm run compile",
    "test": "node ./out/test/runTest.js",
    "test:watch": "npm run compile && npm run test"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/markdown-it": "^14.1.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.10.0",
    "@types/sinon": "^21.0.0",
    "@types/uuid": "^10.0.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "@vscode/test-electron": "^2.5.2",
    "chai": "^6.2.2",
    "eslint": "^8.54.0",
    "glob": "^13.0.0",
    "mocha": "^11.7.5",
    "sinon": "^21.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "@vscode/codicons": "^0.0.44",
    "uuid": "^9.0.0"
  }
}
