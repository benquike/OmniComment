{
  "name": "omnicomment",
  "displayName": "OmniComment - Universal Comments & Annotations",
  "description": "Universal commenting and inline annotation system for editors, web, and AI agents",
  "version": "0.1.24",
  "license": "MIT",
  "publisher": "benquike",
  "repository": {
    "type": "git",
    "url": "https://github.com/benquike/OmniComment.git"
  },
  "bugs": {
    "url": "https://github.com/benquike/OmniComment/issues"
  },
  "homepage": "https://github.com/benquike/OmniComment#readme",
  "icon": "media/omnicomment.png",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:markdown",
    "onLanguage:skill",
    "onLanguage:plaintext",
    "onLanguage:text",
    "onLanguage:txt",
    "onLanguage:log",
    "onCommand:omnicomment.addComment",
    "onCommand:omnicomment.toggleSidebar",
    "onView:omnicomment.commentSidebar",
    "onCustomEditor:zaaack.markdown-editor",
    "onCustomEditor:cweijan.markdownViewer",
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configurationDefaults": {
      "editor.glyphMargin": true,
      "[markdown]": {
        "editor.glyphMargin": true
      },
      "[plaintext]": {
        "editor.glyphMargin": true
      },
      "[text]": {
        "editor.glyphMargin": true
      },
      "[txt]": {
        "editor.glyphMargin": true
      },
      "[log]": {
        "editor.glyphMargin": true
      },
      "[skill]": {
        "editor.glyphMargin": true
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "omnicomment-sidebar",
          "title": "OmniComment Comments",
          "icon": "$(comment-discussion)"
        }
      ]
    },
    "views": {
      "omnicomment-sidebar": [
        {
          "type": "webview",
          "id": "omnicomment.commentSidebar",
          "name": "Comments"
        }
      ]
    },
    "commands": [
      {
        "command": "omnicomment.addComment",
        "title": "Add Comment",
        "category": "OmniComment",
        "icon": "$(comment)"
      },
      {
        "command": "omnicomment.deleteComment",
        "title": "Delete Comment",
        "category": "OmniComment"
      },
      {
        "command": "omnicomment.editComment",
        "title": "Edit Comment",
        "category": "OmniComment"
      },
      {
        "command": "omnicomment.toggleSidebar",
        "title": "Toggle Comment Sidebar",
        "category": "OmniComment"
      },
      {
        "command": "omnicomment.navigateToComment",
        "title": "Navigate to Comment",
        "category": "OmniComment"
      },
      {
        "command": "omnicomment.editorCommentAction",
        "title": "In-Editor Comment Action",
        "category": "OmniComment"
      },
      {
        "command": "omnicomment.inlineReplyComment",
        "title": "Submit Comment / Reply",
        "icon": "$(send)",
        "category": "OmniComment"
      },
      {
        "command": "omnicomment.inlineToggleResolve",
        "title": "Resolve / Reopen Comment",
        "category": "OmniComment",
        "icon": "$(check)"
      },
      {
        "command": "omnicomment.inlineToggleCollapseThread",
        "title": "Collapse / Expand Comment Thread",
        "category": "OmniComment",
        "icon": "$(chevron-up)"
      },
      {
        "command": "omnicomment.inlineDeleteThread",
        "title": "Delete Comment Thread",
        "category": "OmniComment",
        "icon": "$(trash)"
      },
      {
        "command": "omnicomment.inlineReplyToComment",
        "title": "Reply to This Comment",
        "category": "OmniComment",
        "icon": "$(reply)"
      },
      {
        "command": "omnicomment.inlineDeleteCommentItem",
        "title": "Delete Comment / Response",
        "category": "OmniComment",
        "icon": "$(trash)"
      },
      {
        "command": "omnicomment.toggleCollapseAllComments",
        "title": "Collapse / Expand All In-Editor Comments",
        "category": "OmniComment",
        "icon": "$(collapse-all)"
      },
      {
        "command": "omnicomment.applyPreset",
        "title": "Apply Preset Configuration...",
        "category": "OmniComment",
        "icon": "$(gear)"
      },
      {
        "command": "omnicomment.agent.getComments",
        "title": "Agent: Get Comments",
        "category": "OmniComment"
      },
      {
        "command": "omnicomment.agent.postComment",
        "title": "Agent: Post Comment",
        "category": "OmniComment"
      },
      {
        "command": "omnicomment.agent.replyComment",
        "title": "Agent: Reply Comment",
        "category": "OmniComment"
      },
      {
        "command": "omnicomment.agent.resolveComment",
        "title": "Agent: Resolve Comment",
        "category": "OmniComment"
      },
      {
        "command": "omnicomment.agent.deleteComment",
        "title": "Agent: Delete Comment",
        "category": "OmniComment"
      },
      {
        "command": "omnicomment.configureCommentBox",
        "title": "Configure Comment Box...",
        "category": "OmniComment"
      }
    ],
    "menus": {
      "comments/commentingRange/context": [
        {
          "command": "omnicomment.addComment",
          "group": "inline@1"
        }
      ],
      "editor/lineNumber/context": [
        {
          "when": "editorLangId =~ /^(markdown|skill|plaintext|text|txt|log)$/ || resourceExtname =~ /\\.(md|markdown|mdown|mkdn|mkd|skill|txt|text|log)$/i",
          "command": "omnicomment.addComment",
          "group": "navigation@1"
        }
      ],
      "editor/context": [
        {
          "when": "editorLangId =~ /^(markdown|skill|plaintext|text|txt|log)$/ || resourceExtname =~ /\\.(md|markdown|mdown|mkdn|mkd|skill|txt|text|log)$/i",
          "command": "omnicomment.addComment",
          "group": "navigation@1"
        },
        {
          "when": "editorLangId =~ /^(markdown|skill|plaintext|text|txt|log)$/ || resourceExtname =~ /\\.(md|markdown|mdown|mkdn|mkd|skill|txt|text|log)$/i",
          "command": "omnicomment.configureCommentBox",
          "group": "navigation@2"
        }
      ],
      "editor/title": [
        {
          "when": "editorLangId =~ /^(markdown|skill|plaintext|text|txt|log)$/ || resourceExtname =~ /\\.(md|markdown|mdown|mkdn|mkd|skill|txt|text|log)$/i || activeCustomEditorId == cweijan.markdownViewer || activeCustomEditorId == zaaack.markdown-editor",
          "command": "omnicomment.addComment",
          "group": "navigation@1"
        },
        {
          "when": "editorLangId =~ /^(markdown|skill|plaintext|text|txt|log)$/ || resourceExtname =~ /\\.(md|markdown|mdown|mkdn|mkd|skill|txt|text|log)$/i",
          "command": "omnicomment.toggleCollapseAllComments",
          "group": "navigation@2"
        },
        {
          "when": "editorLangId =~ /^(markdown|skill|plaintext|text|txt|log)$/ || resourceExtname =~ /\\.(md|markdown|mdown|mkdn|mkd|skill|txt|text|log)$/i || activeCustomEditorId == cweijan.markdownViewer || activeCustomEditorId == zaaack.markdown-editor",
          "command": "omnicomment.configureCommentBox",
          "group": "navigation@3"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "omnicomment.inlineReplyComment",
          "when": "commentController == omnicomment-inline",
          "group": "inline"
        },
        {
          "command": "omnicomment.configureCommentBox",
          "when": "commentController == omnicomment-inline",
          "group": "inline@2"
        }
      ],
      "comments/commentThread/title": [
        {
          "command": "omnicomment.inlineToggleResolve",
          "when": "commentController == omnicomment-inline",
          "group": "navigation@1"
        },
        {
          "command": "omnicomment.inlineToggleCollapseThread",
          "when": "commentController == omnicomment-inline",
          "group": "navigation@2"
        },
        {
          "command": "omnicomment.inlineDeleteThread",
          "when": "commentController == omnicomment-inline",
          "group": "navigation@3"
        },
        {
          "command": "omnicomment.configureCommentBox",
          "when": "commentController == omnicomment-inline",
          "group": "navigation@4"
        }
      ],
      "comments/comment/title": [
        {
          "command": "omnicomment.inlineReplyToComment",
          "when": "commentController == omnicomment-inline",
          "group": "inline@1"
        },
        {
          "command": "omnicomment.inlineDeleteCommentItem",
          "when": "commentController == omnicomment-inline",
          "group": "inline@2"
        }
      ]
    },
    "keybindings": [
      {
        "command": "omnicomment.addComment",
        "key": "ctrl+shift+m",
        "mac": "cmd+shift+m",
        "when": "editorLangId =~ /^(markdown|skill|plaintext|text|txt|log)$/ || resourceExtname =~ /\\.(md|markdown|mdown|mkdn|mkd|skill|txt|text|log)$/i || activeCustomEditorId == cweijan.markdownViewer || activeCustomEditorId == zaaack.markdown-editor"
      }
    ],
    "configuration": {
      "title": "OmniComment",
      "properties": {
        "omnicomment.preset": {
          "type": "string",
          "enum": [
            "default",
            "documentation-site",
            "git-file-review",
            "browser-annotator",
            "team-collaboration",
            "ai-agent-reviewer"
          ],
          "default": "default",
          "description": "Pre-configured profile tailoring UI density, storage mode, and agent review capabilities"
        },
        "omnicomment.highlightColor": {
          "type": "string",
          "default": "rgba(255, 212, 0, 0.3)",
          "description": "Background color for comment highlights"
        },
        "omnicomment.highlightBorderColor": {
          "type": "string",
          "default": "rgba(255, 212, 0, 0.8)",
          "description": "Border color for comment highlights"
        },
        "omnicomment.commentBox.widthMode": {
          "type": "string",
          "enum": [
            "compact",
            "standard",
            "wide",
            "custom"
          ],
          "default": "standard",
          "description": "Width density preset for inline comment cards: compact (280-360px), standard (320-460px), wide (420-640px), or custom"
        },
        "omnicomment.commentBox.minWidth": {
          "type": "number",
          "default": 320,
          "minimum": 200,
          "maximum": 1200,
          "description": "Minimum width in pixels for the comment box (used when widthMode is 'custom' or as lower bound)"
        },
        "omnicomment.commentBox.maxWidth": {
          "type": "number",
          "default": 460,
          "minimum": 240,
          "maximum": 1600,
          "description": "Maximum width in pixels for the comment box (used when widthMode is 'custom' or as upper bound)"
        },
        "omnicomment.commentBox.fontSize": {
          "type": "number",
          "default": 12,
          "minimum": 9,
          "maximum": 24,
          "description": "Base font size in pixels for comment cards and thread content"
        },
        "omnicomment.commentBox.enableMarkdown": {
          "type": "boolean",
          "default": true,
          "description": "Whether to render rich Markdown (code blocks, quotes, lists, bold, links) inside comments"
        },
        "omnicomment.commentBox.showAvatars": {
          "type": "boolean",
          "default": true,
          "description": "Show author initial avatar badges in comment headers and replies"
        },
        "omnicomment.commentBox.showThreadGuide": {
          "type": "boolean",
          "default": true,
          "description": "Display a vertical connector guide line for reply discussion threads"
        },
        "omnicomment.commentBox.defaultAuthor": {
          "type": "string",
          "default": "",
          "description": "Default author name for new comments and replies (falls back to git user name or OS username)"
        },
        "omnicomment.selectionCodeLens": {
          "type": "boolean",
          "default": true,
          "description": "Show a clickable \"💬 Add Comment\" CodeLens above the selected text in text editors (.txt, .log, .md source)"
        }
      }
    },
    "markdown.markdownItPlugins": true,
    "markdown.previewStyles": [
      "./media/preview.css"
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts",
    "pretest": "npm run compile",
    "test": "node ./out/test/runTest.js",
    "test:watch": "npm run compile && npm run test",
    "docs:build": "node scripts/render-docs.js",
    "docs:serve": "node scripts/render-docs.js --serve"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/markdown-it": "^14.1.2",
    "@types/marked": "^2.0.5",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.10.0",
    "@types/sinon": "^21.0.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "@vscode/test-electron": "^2.5.2",
    "chai": "^6.2.2",
    "eslint": "^8.54.0",
    "glob": "^13.0.0",
    "marked": "^16.0.0",
    "mocha": "^11.7.5",
    "sinon": "^21.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "@vscode/codicons": "^0.0.44"
  }
}
